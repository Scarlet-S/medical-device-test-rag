{
  "schema_version": 1,
  "name": "online-graphrag-unseen-validation-v1",
  "frozen_before_first_run": true,
  "description": "未参与图谱结构设计的改写问题，用于对照真实RAGFlow切片上的普通词法召回与GraphRAG证据链。",
  "cases": [
    {
      "case_id": "OG001",
