      "expected_nodes": ["software_update", "regression_scope", "regression_result", "defect_record"]
    },
    {
      "case_id": "OG003",
      "type": "multi_hop",
      "question": "威胁分析识别攻击路径以后，控制验证与未修复漏洞处置之间如何衔接？",
      "expected_nodes": ["threat_model", "security_control", "security_test", "residual_vulnerability"]
